# Spark
SPARK_APP_NAME=RetailPulseSparkProcessor
SPARK_MASTER=local[*]

# MinIO / S3A
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE_ACCESS=true
S3_SSL_ENABLED=false

# Data Lake
DATA_LAKE_BUCKET=retailpulse-dev

RAW_SALES_PATH=s3a://retailpulse-dev/raw/sales/
BRONZE_SALES_PATH=s3a://retailpulse-dev/bronze/sales/

# Logging
LOG_LEVEL=INFO